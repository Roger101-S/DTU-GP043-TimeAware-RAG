# Copy to .env and edit. Never commit your real .env.

# --- Embeddings -------------------------------------------------------------
# minilm = sentence-transformers/all-MiniLM-L6-v2 (as in the report)
# tfidf  = built-in, no download, deterministic (good for quick tests / CI)
EMBEDDER=minilm

# --- LLM (used by the answer generator and, optionally, the arbitrator) -----
# none | groq | gemini | ollama      ("none" = fully offline, rule-based reader)
LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
# Model names change often: check your provider's current model list.

# --- Arbitrator -------------------------------------------------------------
# rules  = lexicon-based state extraction (no LLM calls)
# hybrid = rules first; LLM only for notes that mention the condition but the rules could not classify
# llm    = LLM extracts the state from every retrieved note
ARBITRATOR_MODE=rules

# --- Retrieval / baseline hyper-parameters ----------------------------------
TOP_K=5
DECAY_HALF_LIFE_DAYS=365
DECAY_ALPHA=0.6
DATE_ORDER=DMY
SEED=42
